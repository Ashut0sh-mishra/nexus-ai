{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "CANONICAL layout registry. Edit here ONLY. Both backend (backend/agent/layouts_registry.py loads this file) and frontend (frontend/src/design/registry.js imports it) consume the same JSON. The npm script `verify:layouts` fails CI if either side drifts.",
  "version": 1,
  "layouts": [
    { "name": "title",            "exported": true,  "schema": ["title", "subtitle", "eyebrow", "image_url"] },
    { "name": "section",          "exported": true,  "schema": ["title", "subtitle", "eyebrow"] },
    { "name": "bullets",          "exported": true,  "schema": ["title", "bullets", "subtitle"] },
    { "name": "two-col",          "exported": true,  "schema": ["title", "columns"] },
    { "name": "comparison",       "exported": true,  "schema": ["title", "columns"] },
    { "name": "kpi",              "exported": true,  "schema": ["title", "stats[].value", "stats[].label"] },
    { "name": "quote",            "exported": true,  "schema": ["quote", "attribution"] },
    { "name": "stats",            "exported": true,  "schema": ["title", "stats[].value", "stats[].label"] },
    { "name": "chart",            "exported": true,  "schema": ["title", "chart_type", "chart_data"] },
    { "name": "table",            "exported": false, "schema": ["title", "headers", "rows"] },
    { "name": "timeline",         "exported": true,  "schema": ["title", "events[].year", "events[].title"] },
    { "name": "image-focus",      "exported": false, "schema": ["title", "image_url", "caption"] },
    { "name": "closing",          "exported": true,  "schema": ["title", "subtitle"] },
    { "name": "hero",             "exported": true,  "schema": ["title", "subtitle", "eyebrow", "image_url"] },
    { "name": "bento",            "exported": true,  "schema": ["title", "bullets"] },
    { "name": "agenda",           "exported": true,  "schema": ["title", "bullets"] },
    { "name": "roadmap",          "exported": true,  "schema": ["title", "bullets"] },
    { "name": "metric-spotlight", "exported": true,  "schema": ["title", "stats[0].value", "stats[0].label", "bullets"] },
    { "name": "process",          "exported": true,  "schema": ["title", "bullets"] },
    { "name": "pyramid",          "exported": true,  "schema": ["title", "bullets"] },
    { "name": "matrix-2x2",       "exported": true,  "schema": ["title", "bullets", "axis"] },
    { "name": "feature-grid",     "exported": true,  "schema": ["title", "bullets"] },
    { "name": "callout",          "exported": true,  "schema": ["title", "callout", "bullets"] }
  ],
  "aliases": {
    "chart_focus": "chart",
    "chart-focus": "chart",
    "image_text": "image-focus",
    "image-text": "image-focus",
    "kpi_grid": "kpi",
    "kpi-grid": "kpi",
    "kpis": "kpi",
    "bullet_list": "bullets",
    "bullet-list": "bullets",
    "list": "bullets",
    "versus": "comparison",
    "vs": "comparison",
    "two_col": "two-col",
    "twocol": "two-col",
    "two-column": "two-col",
    "grid": "bento",
    "cards": "bento",
    "bento-grid": "bento",
    "icon-cards": "feature-grid",
    "toc": "agenda",
    "table-of-contents": "agenda",
    "timeline-horizontal": "roadmap",
    "journey": "roadmap",
    "steps": "process",
    "workflow": "process",
    "flow": "process",
    "hierarchy": "pyramid",
    "stack": "pyramid",
    "quadrant": "matrix-2x2",
    "2x2": "matrix-2x2",
    "matrix": "matrix-2x2",
    "features": "feature-grid",
    "feature_grid": "feature-grid",
    "highlight": "callout",
    "big-number": "metric-spotlight",
    "big_metric": "metric-spotlight",
    "big_number": "metric-spotlight",
    "metric": "metric-spotlight",
    "banner": "hero",
    "cover": "title"
  },
  "fallback": "bullets"
}
