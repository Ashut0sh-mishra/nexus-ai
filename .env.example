# =============================================================================
# NEXUS — Environment configuration template
# Copy to `.env` and fill in keys. ALL providers are optional individually,
# but at least ONE AI provider key must be set.
# =============================================================================

# ── AI MODEL CHAIN ───────────────────────────────────────────────────────────
# The chain is tried in order; first available + working provider wins.
# Override AI_PROVIDER_CHAIN to disable tiers (comma-separated).
#
# Phase 6W-stable runtime profile: only providers with verified-working
# credentials are listed by default. All 10 providers remain SUPPORTED in
# code and visible in /api/health -- the disabled ones are operationally
# disabled, not removed.
#   - Gemini, OpenRouter, Cerebras: supported, but excluded from the default
#     chain due to free-tier 429 rate-limit risk. Add them back once you have
#     paid keys or are willing to accept transient failures.
#   - Mistral, GitHub Models: supported, but excluded until valid inference
#     credentials exist (current keys return 401 from the provider).
AI_PROVIDER_CHAIN=groq,nvidia_nim,sambanova

# 1) OpenRouter — Kimi K2 (FREE)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k2:free

# 2) NVIDIA NIM — Kimi K2.5 (FREE)  https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# 3) Gemini 2.0 Flash (FREE 1000/day)  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4) Groq Llama 3.3 70B (FREE, fastest)  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# 5) Anthropic Claude (paid fallback)  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PROD=claude-sonnet-4-6
ANTHROPIC_MODEL_DEV=claude-opus-4-7

# 6) OpenAI (paid fallback)  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_FALLBACK=gpt-4.1

# 7) Cerebras (FREE fast Llama 3.3 70B)  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# 8) SambaNova Cloud (FREE Llama 3.3 70B)  https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 9) Mistral AI (low-cost)  https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# 10) GitHub Models (FREE via Azure)  https://github.com/marketplace/models
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o-mini

# Token / context pruning (Phase 6W)
MAX_CONTEXT_TOKENS=6000
KEEP_LAST_MESSAGES=5

# ── SEARCH & BROWSER ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BROWSERLESS_API_KEY=

# ── DATABASE & QUEUE ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# ── FILE STORAGE (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexus-exports
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── PRODUCTION LOCK-DOWN (Phase 6AL) ───────────────────────────────────────────
# Shared key between the deployed backend and frontend. The backend's
# SecurityMiddleware rejects any request without a matching X-Nexus-Key header.
# Set the SAME value as the frontend build's VITE_NEXUS_KEY.
# Leave EMPTY in local dev to disable the gate.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_API_KEY=
SECRET_KEY=change-me-in-production

# ── APP ──────────────────────────────────────────────────────────────────────
APP_NAME=NEXUS
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEBUG=true

# ── MONITORING ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── PAYMENTS (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
