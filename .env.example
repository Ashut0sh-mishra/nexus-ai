# =============================================================================
# NEXUS — Environment configuration template
# Copy to `.env` and fill in keys. ALL providers are optional individually,
# but at least ONE AI provider key must be set.
# =============================================================================

# ── AI MODEL CHAIN ───────────────────────────────────────────────────────────
# The chain is tried in order; first available + working provider wins.
# Override AI_PROVIDER_CHAIN to disable tiers (comma-separated).
AI_PROVIDER_CHAIN=openrouter,nvidia_nim,gemini,groq,anthropic,openai

# 1) OpenRouter — Kimi K2 (FREE)  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=moonshotai/kimi-k2:free

# 2) NVIDIA NIM — Kimi K2.5 (FREE)  https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.5

# 3) Gemini 2.0 Flash (FREE 1000/day)  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 4) Groq Llama 3.3 70B (FREE, fastest)  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# 5) Anthropic Claude (paid fallback)  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PROD=claude-sonnet-4-6
ANTHROPIC_MODEL_DEV=claude-opus-4-7

# 6) OpenAI (paid fallback)  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_FALLBACK=gpt-4.1

# ── SEARCH & BROWSER ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BROWSERLESS_API_KEY=

# ── STOCK IMAGES (optional — falls back to Pollinations AI when unset) ───────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── DATABASE & QUEUE ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# ── FILE STORAGE (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexus-exports
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── APP ──────────────────────────────────────────────────────────────────────
APP_NAME=NEXUS
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEBUG=true

# ── UPLOADS ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=csv,xlsx,xls,json,pdf,docx,pptx,txt,md

# ── MONITORING ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── PAYMENTS (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
